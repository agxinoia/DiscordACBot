# Install to /etc/eac-tracker.env, owned by root with mode 600.
# systemd reads this via EnvironmentFile; values are not shell-expanded, so do
# not quote the token.
#
# This is the only thing the bot requires. Channels and tracked games are
# configured from Discord with /eac.
DISCORD_TOKEN=your-token-here

# Optional: register /eac to one server so it appears immediately instead of
# taking up to an hour to propagate globally.
# DISCORD_GUILD_ID=123456789012345678
